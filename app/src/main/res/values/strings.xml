    <!-- Clear codes: two confirmations -->
    <string name="btn_ok">OK</string>
    <string name="btn_cancel">Cancel</string>
    <string name="btn_continue">Continue</string>
    <string name="btn_clear_now">Clear codes now</string>
    <string name="clear_engine_title">Turn the engine off first</string>
    <string name="clear_engine_body">Codes can only be cleared with the ignition on and the engine off. Stop the engine, leave the ignition on, wait until RPM shows 0 and tap Clear codes again.</string>
    <string name="clear_intro_title">Clear fault codes?</string>
    <string name="clear_intro_what_label">What happens</string>
    <string name="clear_intro_what">The stored and pending codes, the freeze frame and the readiness monitors are erased. The check-engine light goes off.</string>
    <string name="clear_intro_then_label">Afterwards</string>
    <string name="clear_intro_then">The monitors need a drive cycle before they are ready again. If the fault is still there, the codes come back.</string>
    <string name="clear_requirements_label">Required</string>
    <string name="clear_requirements">Ignition on, engine off.</string>
    <string name="clear_final_title">Clear codes now?</string>
    <string name="clear_final_body">This erases the codes, the freeze frame and the readiness monitors, and it cannot be undone. Only continue if you are sure.</string>

